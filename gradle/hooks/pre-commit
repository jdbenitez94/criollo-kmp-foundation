#!/bin/bash

set -e

echo "=========================================="
echo "criollo-kmp-foundation pre-commit quality checks"
echo "=========================================="
echo ""

REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_DIR" || exit 1

LOG_DIR="$REPO_DIR/build/hooks/logs"
mkdir -p "$LOG_DIR"

echo "Step 1/3: Running ktlintFormat..."
STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.kts?$' || true)

KTLINT_FORMAT_EXIT_CODE=0
# Do not override org.gradle.jvmargs here — a tiny MaxMetaspaceSize OOMs KMP/iOS
# compiles pulled in by formatting tasks. Use gradle.properties instead.
./gradlew ktlintFormat --no-daemon >"$LOG_DIR/ktlint-format.log" 2>&1 || KTLINT_FORMAT_EXIT_CODE=$?

if [ $KTLINT_FORMAT_EXIT_CODE -ne 0 ]; then
  if grep -qE "(error|Error|FAILED|failed)" "$LOG_DIR/ktlint-format.log"; then
    echo "ERROR: ktlintFormat failed"
    echo "See: $LOG_DIR/ktlint-format.log"
    echo "Fix: ./gradlew ktlintFormat"
    exit 1
  else
    echo "WARN: ktlintFormat completed with non-blocking warnings"
  fi
fi

if [ -n "$STAGED_KOTLIN_FILES" ]; then
  MODIFIED_FILES=""
  while IFS= read -r file; do
    if [ -f "$file" ]; then
      if ! git diff --quiet "$file" 2>/dev/null; then
        MODIFIED_FILES="$MODIFIED_FILES$file"$'\n'
      fi
    fi
  done <<<"$STAGED_KOTLIN_FILES"

  if [ -n "$MODIFIED_FILES" ]; then
    echo "Re-staging formatted files..."
    echo "$MODIFIED_FILES" | while IFS= read -r file; do
      if [ -n "$file" ] && [ -f "$file" ]; then
        git add "$file" 2>/dev/null && echo "  - $file"
      fi
    done
  fi
fi

echo "Step 2/3: Running ktlintCheck..."
if ! ./gradlew ktlintCheck --no-daemon >"$LOG_DIR/ktlint-check.log" 2>&1; then
  echo "ERROR: ktlintCheck failed"
  echo "See: $LOG_DIR/ktlint-check.log"
  echo "Fix: ./gradlew ktlintFormat"
  exit 1
fi

echo "Step 3/3: Running detekt (non-blocking baseline)..."
DETEKT_EXIT_CODE=0
./gradlew detekt --no-daemon >"$LOG_DIR/detekt.log" 2>&1 || DETEKT_EXIT_CODE=$?
if [ $DETEKT_EXIT_CODE -ne 0 ]; then
  echo "WARN: detekt reported issues (non-blocking)"
  echo "See: $LOG_DIR/detekt.log"
else
  echo "OK: detekt passed"
fi

echo ""
echo "Pre-commit checks completed."
